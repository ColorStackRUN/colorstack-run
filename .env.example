# Local dev: http://localhost:3000 — production: https://colorstackrun.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Google Search Console HTML tag verification (server-only, not bundled)
GOOGLE_SITE_VERIFICATION=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional server-side alias for scripts and privileged CMS writes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=site-media
# Set to true for any local or demo server that must never write to production.
DISABLE_ADMIN_PUBLISHING=false

# Set to "true" to take the public site offline and show /maintenance.
# Admin routes (/admin, /api/admin) stay reachable so content can still be edited.
MAINTENANCE_MODE=false
